+void scalar(Writer& w,const Value& value) {
+  w.object([&](auto& o) {
+    o.text("type",type_name(type_of(value)));
+    o.field("value",[&] { std::visit([&](const auto& item) {
+      using T=std::decay_t<decltype(item)>;
