+    target_compile_options(crown_${name}_test PRIVATE -UNDEBUG)
+    target_link_libraries(crown_${name}_test PRIVATE ${library} crown_options)
+    add_test(NAME ${name} COMMAND crown_${name}_test ${ARGN})
+    set_tests_properties(${name} PROPERTIES TIMEOUT 900 LABELS C05)
+  endfunction()
