+        // CROWN local repair: allocation failure during flattening must not
+        // escape a noexcept JSON destructor. Prune last leaves iteratively;
+        // erasing the last member also avoids ordered_map key-shift copies.
+        // This deliberately slower path is used only after std::bad_alloc.
+        static void clear_without_allocation(basic_json& root) noexcept
+        {
+            while (root.is_structured() && !root.empty())
+            {
+                auto* parent = &root;
+                auto child = parent->end();
+                --child;
+                while (child->is_structured() && !child->empty())
+                {
+                    parent = &*child;
+                    child = parent->end();
+                    --child;
+                }
+                parent->erase(child);
+            }
+            root.clear();
+        }
