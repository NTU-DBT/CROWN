+  crown_add_statistics_test(statistics_owner_exceptions owner_statistics_exception_test crown_runtime)
+  crown_add_statistics_test(statistics_collection statistics_collection_test crown_runtime_testing)
+  target_include_directories(crown_statistics_collection_test PRIVATE src/runtime)
+  crown_add_statistics_test(statistics_workload workload_statistics_test crown_runtime_testing)
+  target_include_directories(crown_statistics_workload_test PRIVATE src/runtime)
+  crown_add_statistics_test(statistics_workload_exceptions workload_statistics_exception_test crown_runtime_testing)
+  crown_add_statistics_test(statistics_scalars scalar_statistics_test crown_runtime)
+
