+    target_include_directories(crown_${name}_test PRIVATE tests/support)
+    target_compile_options(crown_${name}_test PRIVATE -UNDEBUG)
+    target_link_libraries(crown_${name}_test PRIVATE ${library} crown_options ${ARGN})
+    add_test(NAME ${name} COMMAND crown_${name}_test)
+    set_tests_properties(${name} PROPERTIES TIMEOUT 900 LABELS C01)
+  endfunction()
+
