 using namespace c05_independent;
+// Diagnostic-only output precedes/follows API calls, outside their accounting
+// and timing intervals. All original operations and assertions remain intact.
+const char* diagnostic_scenario="initialization";
+std::uint64_t diagnostic_call=0;
+int diagnostic_field=-1;
+void diagnostic_group(const char* name) {
+  diagnostic_scenario=name;diagnostic_field=-1;
+  std::cerr<<"diagnostic group="<<diagnostic_scenario<<'\n';
+}
+void diagnostic_before(const char* label,
+                       const std::source_location where=std::source_location::current()) {
+  ++diagnostic_call;
+  std::cerr<<"diagnostic begin scenario="<<diagnostic_scenario<<" call="<<diagnostic_call
+      <<" label="<<label<<" field="<<diagnostic_field<<" source_line="<<where.line()<<'\n';
+}
+template<class Attempt>
+void diagnostic_after(const Attempt& attempt) {
+  std::cerr<<"diagnostic result scenario="<<diagnostic_scenario<<" call="<<diagnostic_call
+      <<" field="<<diagnostic_field<<" stop="<<static_cast<int>(attempt.stop)
+      <<" stage="<<static_cast<int>(attempt.stage)<<" resource="<<static_cast<int>(attempt.resource)
+      <<" component_stop="<<(attempt.component_stop?static_cast<int>(*attempt.component_stop):-1)
+      <<" reasons="<<attempt.reasons<<" has_selection="<<attempt.selection.has_value()
+      <<" work="<<attempt.usage.work<<" cells="<<attempt.usage.cells
+      <<" key_bytes="<<attempt.usage.binding_key_bytes<<" payload_bytes="<<attempt.usage.payload_bytes
+      <<" lowering_work="<<attempt.usage.lowering_work<<" identity_work="<<attempt.usage.identity_work
+      <<" binding_replay_work="<<attempt.usage.binding_replay_work
+      <<" normalization_work="<<attempt.usage.normalization_work<<'\n';
+}
