{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crown.local/schemas/measurement-experiment-v1.schema.json",
  "title": "Controlled repeated workload measurement packet",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "kind", "status", "started_utc", "manifest_sha256", "environment", "build", "configuration", "manifest_validation", "correctness_gate", "compilation", "verification", "runs", "summaries", "limits"],
  "properties": {
    "schema_version": {"const": 1}, "kind": {"const": "controlled_workload_measurements"},
    "status": {"enum": ["running", "complete", "failed"]}, "started_utc": {"type": "string"}, "completed_utc": {"type": "string"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"}, "commands_sha256": {"$ref": "#/$defs/sha256"},
    "environment": {"type": "object"}, "build": {"type": "object"}, "manifest_validation": {"type": "object"},
    "configuration": {"type": "object", "additionalProperties": false,
      "required": ["case_ids", "modes", "backends", "repetitions", "warmups", "codec", "sink", "sink_delay_us", "observation", "workload_counters", "cpu", "single_writer", "schedule_seed", "command_timeout_seconds", "max_total_raw_bytes"],
      "properties": {"case_ids": {"$ref": "#/$defs/strings"}, "modes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["maintenance", "snapshot", "delta"]}},
        "backends": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["reference_ordered_v1", "indexed_chained_v1"]}},
        "repetitions": {"type": "integer", "minimum": 1, "maximum": 30}, "warmups": {"type": "integer", "minimum": 0, "maximum": 5},
        "codec": {"enum": ["none", "jsonl"]}, "sink": {"enum": ["discard", "file"]}, "sink_delay_us": {"type": "integer", "minimum": 0, "maximum": 100000},
        "observation": {"enum": ["off", "counters", "timed"]}, "workload_counters": {"type": "boolean"},
        "cpu": {"anyOf": [{"type": "null"}, {"type": "integer", "minimum": 0}]}, "single_writer": {"const": true},
        "schedule_seed": {"type": "integer"}, "command_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "max_total_raw_bytes": {"type": "integer", "minimum": 1, "maximum": 4294967296}}},
    "correctness_gate": {"enum": ["pending", "passed_all_configurations_before_warmup_or_measurement"]},
    "compilation": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["query", "backend", "warmup", "repetition", "command", "process_wall_ns", "process_maxrss_KiB"],
      "properties": {"query": {"type": "string"}, "backend": {"type": "string"}, "warmup": {"type": "boolean"}, "repetition": {"type": "integer"}, "command": {"$ref": "#/$defs/count"}, "process_wall_ns": {"$ref": "#/$defs/count"}, "process_maxrss_KiB": {"$ref": "#/$defs/count"}}}},
    "verification": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["label", "command", "receipt_sha256", "binding_sha256", "input_sha256", "oracle_sha256", "passed"],
      "properties": {"label": {"type": "string"}, "command": {"$ref": "#/$defs/count"}, "receipt_sha256": {"$ref": "#/$defs/sha256"}, "binding_sha256": {"$ref": "#/$defs/sha256"},
        "input_sha256": {"$ref": "#/$defs/sha256"}, "oracle_sha256": {"$ref": "#/$defs/sha256"}, "passed": {"const": true}}}},
    "runs": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["label", "warmup", "repetition", "command", "raw_report", "raw_report_sha256", "process_maxrss_KiB", "collector_binding_sha256"],
      "properties": {"label": {"type": "string"}, "warmup": {"type": "boolean"}, "repetition": {"type": "integer"}, "command": {"$ref": "#/$defs/count"},
        "raw_report": {"type": "string"}, "raw_report_sha256": {"$ref": "#/$defs/sha256"}, "process_maxrss_KiB": {"$ref": "#/$defs/count"}, "collector_binding_sha256": {"$ref": "#/$defs/sha256"}}}},
    "summaries": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["label", "runs", "update_latency_ns", "native_prepare_commit_ns", "output_call_latency_ns", "first_result_delay_ns", "successful_next_ns", "termination_next_ns", "query_current_requested_bytes", "query_cumulative_peak_requested_bytes", "loop_wall_ns", "phases", "output_rows", "accounting"],
      "properties": {"label": {"type": "string"}, "runs": {"$ref": "#/$defs/count"}, "update_latency_ns": {"$ref": "#/$defs/distribution"}, "native_prepare_commit_ns": {"$ref": "#/$defs/distribution"},
        "output_call_latency_ns": {"$ref": "#/$defs/distribution"}, "first_result_delay_ns": {"$ref": "#/$defs/distribution"}, "successful_next_ns": {"$ref": "#/$defs/distribution"}, "termination_next_ns": {"$ref": "#/$defs/distribution"},
        "query_current_requested_bytes": {"$ref": "#/$defs/distribution"}, "query_cumulative_peak_requested_bytes": {"$ref": "#/$defs/distribution"}, "loop_wall_ns": {"$ref": "#/$defs/distribution"},
        "phases": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": {"$ref": "#/$defs/count"}}}, "output_rows": {"$ref": "#/$defs/count"}, "accounting": {"type": "string"}}}},
    "compilation_summaries": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["query", "backend", "process_wall_ns", "process_maxrss_KiB"],
      "properties": {"query": {"type": "string"}, "backend": {"type": "string"}, "process_wall_ns": {"$ref": "#/$defs/distribution"}, "process_maxrss_KiB": {"$ref": "#/$defs/distribution"}}}},
    "limits": {"$ref": "#/$defs/strings"}, "error": {"type": "string"}
  },
  "allOf": [{"if": {"properties": {"status": {"const": "complete"}}}, "then": {"required": ["completed_utc", "commands_sha256", "compilation_summaries"], "properties": {"correctness_gate": {"const": "passed_all_configurations_before_warmup_or_measurement"}}, "not": {"required": ["error"]}}},
            {"if": {"properties": {"status": {"const": "failed"}}}, "then": {"required": ["completed_utc", "error"]}}],
  "$defs": {
    "count": {"type": "integer", "minimum": 0}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "strings": {"type": "array", "items": {"type": "string"}},
    "optional_count": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/count"}]},
    "optional_number": {"anyOf": [{"type": "null"}, {"type": "number", "minimum": 0}]},
    "distribution": {"type": "object", "additionalProperties": false,
      "required": ["samples", "minimum", "maximum", "sum", "mean", "standard_deviation", "p50", "p95", "p99", "percentile_method", "histogram"],
      "properties": {"samples": {"$ref": "#/$defs/count"}, "minimum": {"$ref": "#/$defs/optional_count"}, "maximum": {"$ref": "#/$defs/optional_count"}, "sum": {"$ref": "#/$defs/count"},
        "mean": {"$ref": "#/$defs/optional_number"}, "standard_deviation": {"$ref": "#/$defs/optional_number"}, "p50": {"$ref": "#/$defs/optional_count"}, "p95": {"$ref": "#/$defs/optional_count"}, "p99": {"$ref": "#/$defs/optional_count"},
        "percentile_method": {"const": "nearest_rank_ceil_pN"}, "histogram": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["bin", "lower_inclusive", "upper_inclusive", "count"],
          "properties": {"bin": {"$ref": "#/$defs/count"}, "lower_inclusive": {"$ref": "#/$defs/count"}, "upper_inclusive": {"$ref": "#/$defs/count"}, "count": {"$ref": "#/$defs/count"}}}}}}
  }
}
