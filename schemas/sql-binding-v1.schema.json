{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CROWN version-1 SQL binding result",
  "description": "Typed name binding only. A valid binding has not been normalized to a CQ, admitted by a structural planner, or executed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "binding_valid", "admission_status"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "binding_valid": {"type": "boolean"},
    "admission_status": {"type": "string", "const": "not_checked"},
    "phase": {"enum": ["syntax", "catalog", "parameters", "binding"]},
    "source": {"type": "string"},
    "catalog_binding": {"$ref": "catalog-v1.schema.json"},
    "catalog_inheritance": {"type": "string", "const": "none"},
    "requested_semantics": {"enum": ["set", "bag"]},
    "inner_semantics": {"oneOf": [{"enum": ["set", "bag"]}, {"type": "null"}]},
    "result_wrapper": {"enum": ["rows", "exists"]},
    "wrapper_alias": {"type": "string", "minLength": 1},
    "parameters": {"type": "array", "items": {"$ref": "#/$defs/sql_type"}},
    "occurrences": {"type": "array", "items": {"$ref": "#/$defs/occurrence"}},
    "expressions": {"type": "array", "items": {"$ref": "#/$defs/expression"}},
    "predicates": {"type": "array", "items": {"$ref": "#/$defs/expression_id"}},
    "outputs": {"type": "array", "items": {"$ref": "#/$defs/output"}},
    "limits": {"$ref": "#/$defs/limits"},
    "work": {"$ref": "#/$defs/uint64"},
    "diagnostic": {"$ref": "#/$defs/binding_diagnostic"}
  },
  "oneOf": [
    {
      "properties": {"binding_valid": {"const": true}},
      "required": [
        "source", "catalog_binding", "catalog_inheritance", "requested_semantics", "inner_semantics", "result_wrapper", "wrapper_alias",
        "parameters", "occurrences", "expressions", "predicates", "outputs", "limits", "work"
      ],
      "not": {"anyOf": [{"required": ["diagnostic"]}, {"required": ["phase"]}]}
    },
    {
      "properties": {"binding_valid": {"const": false}},
      "required": ["phase", "diagnostic"],
      "not": {
        "anyOf": [
          {"required": ["source"]},
          {"required": ["catalog_binding"]},
          {"required": ["catalog_inheritance"]},
          {"required": ["requested_semantics"]},
          {"required": ["inner_semantics"]},
          {"required": ["result_wrapper"]},
          {"required": ["wrapper_alias"]},
          {"required": ["parameters"]},
          {"required": ["occurrences"]},
          {"required": ["expressions"]},
          {"required": ["predicates"]},
          {"required": ["outputs"]},
          {"required": ["limits"]},
          {"required": ["work"]}
        ]
      }
    }
  ],
  "$defs": {
    "uint64": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "positive_uint64": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
    "expression_id": {"type": "integer", "minimum": 0},
    "source_location": {"type": ["integer", "null"], "minimum": 0},
    "sql_type": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "nullable"],
      "properties": {
        "kind": {"enum": ["unknown", "int32", "int64", "string", "bool", "date", "decimal"]},
        "nullable": {"type": "boolean"},
        "decimal": {"$ref": "catalog-v1.schema.json#/$defs/decimal_spec"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "decimal"}}, "required": ["kind"]},
          "then": {},
          "else": {"not": {"required": ["decimal"]}}
        }
      ]
    },
    "occurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["table", "table_id", "alias", "column_names", "location", "include_descendants"],
      "properties": {
        "table": {"type": "string", "minLength": 1},
        "table_id": {"type": "integer", "minimum": 0},
        "alias": {"type": "string", "minLength": 1},
        "column_names": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "location": {"$ref": "#/$defs/source_location"},
        "include_descendants": {"type": "boolean"}
      }
    },
    "scalar_value": {
      "oneOf": [
        {"type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807},
        {"type": "string"},
        {"type": "boolean"},
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["date"],
          "properties": {"date": {"type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}}
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["decimal"],
          "properties": {"decimal": {"type": "string", "pattern": "^[+-]?[0-9]+(\\.[0-9]+)?$"}}
        }
      ]
    },
    "expression_base": {
      "type": "object",
      "required": ["id", "type", "location"],
      "properties": {
        "id": {"$ref": "#/$defs/expression_id"},
        "type": {"$ref": "#/$defs/sql_type"},
        "location": {"$ref": "#/$defs/source_location"}
      }
    },
    "column_expression": {
      "allOf": [
        {"$ref": "#/$defs/expression_base"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "occurrence", "column"],
          "properties": {
            "id": {"$ref": "#/$defs/expression_id"},
            "type": {"$ref": "#/$defs/sql_type"},
            "location": {"$ref": "#/$defs/source_location"},
            "kind": {"const": "column"},
            "occurrence": {"type": "integer", "minimum": 0},
            "column": {"type": "integer", "minimum": 0}
          }
        }
      ]
    },
    "literal_expression": {
      "allOf": [
        {"$ref": "#/$defs/expression_base"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "id": {"$ref": "#/$defs/expression_id"},
            "type": {"$ref": "#/$defs/sql_type"},
            "location": {"$ref": "#/$defs/source_location"},
            "kind": {"const": "literal"},
            "value": {"$ref": "#/$defs/scalar_value"}
          }
        }
      ]
    },
    "parameter_expression": {
      "allOf": [
        {"$ref": "#/$defs/expression_base"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "number"],
          "properties": {
            "id": {"$ref": "#/$defs/expression_id"},
            "type": {"$ref": "#/$defs/sql_type"},
            "location": {"$ref": "#/$defs/source_location"},
            "kind": {"const": "parameter"},
            "number": {"$ref": "#/$defs/positive_uint64"}
          }
        }
      ]
    },
    "operation_expression": {
      "allOf": [
        {"$ref": "#/$defs/expression_base"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "operator", "arguments"],
          "properties": {
            "id": {"$ref": "#/$defs/expression_id"},
            "type": {"$ref": "#/$defs/sql_type"},
            "location": {"$ref": "#/$defs/source_location"},
            "kind": {"const": "operation"},
            "operator": {
              "enum": [
                "equal", "not_equal", "less", "less_equal", "greater", "greater_equal",
                "conjunction", "disjunction", "negation", "is_null", "is_not_null",
                "is_true", "is_not_true", "is_false", "is_not_false", "is_unknown", "is_not_unknown",
                "identity_cast", "literal_cast", "widen_integer", "using_value"
              ]
            },
            "arguments": {"type": "array", "items": {"$ref": "#/$defs/expression_id"}}
          }
        }
      ]
    },
    "expression": {
      "oneOf": [
        {"$ref": "#/$defs/column_expression"},
        {"$ref": "#/$defs/literal_expression"},
        {"$ref": "#/$defs/parameter_expression"},
        {"$ref": "#/$defs/operation_expression"}
      ]
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "expression"],
      "properties": {
        "name": {"type": "string"},
        "expression": {"$ref": "#/$defs/expression_id"}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_limit", "expression_limit", "recursion_limit"],
      "properties": {
        "work_limit": {"oneOf": [{"$ref": "#/$defs/uint64"}, {"type": "null"}]},
        "expression_limit": {"type": "integer", "minimum": 0},
        "recursion_limit": {"type": "integer", "minimum": 0}
      }
    },
    "binding_diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "byte_offset", "character_position", "line", "column"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "byte_offset": {"type": ["integer", "null"], "minimum": 0},
        "character_position": {"type": ["integer", "null"], "minimum": 1},
        "line": {"type": ["integer", "null"], "minimum": 1},
        "column": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "parameter_declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"$ref": "catalog-v1.schema.json#/$defs/scalar_type"},
        "nullable": {"type": "boolean", "default": false},
        "collation": {"type": "string", "const": "binary", "default": "binary"},
        "decimal": {"$ref": "catalog-v1.schema.json#/$defs/decimal_spec"}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "string"}}, "required": ["type"]},
          "then": {},
          "else": {"not": {"required": ["collation"]}}
        },
        {
          "if": {"properties": {"type": {"const": "decimal"}}, "required": ["type"]},
          "then": {},
          "else": {"not": {"required": ["decimal"]}}
        }
      ]
    },
    "parameter_types_document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "parameters"],
      "properties": {
        "schema_version": {"type": "integer", "const": 1},
        "parameters": {"type": "array", "items": {"$ref": "#/$defs/parameter_declaration"}}
      }
    }
  }
}
